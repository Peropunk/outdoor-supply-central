# Copy this file to .env.local and fill it in. .env.local is never committed.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" key, or the newer "publishable" key (sb_publishable_...). Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key, or the newer "secret" key (sb_secret_...). Server only: full database access.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this deployment, used in sign-in links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows "Continue with Google" once the Google provider is on in Supabase (SETUP.md step 4).
NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED=false
